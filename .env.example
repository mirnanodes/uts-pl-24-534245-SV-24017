# =============================================================================
# Contoh konfigurasi Docker Compose.
#   1. Salin file ini menjadi .env   (cp .env.example .env)
#   2. Isi semua nilai yang kosong / bertanda "ganti".
# File .env berisi rahasia dan TIDAK BOLEH di-commit (sudah ada di .gitignore).
# =============================================================================

# Kunci enkripsi Laravel. Buat dengan:  php artisan key:generate --show
# (dijalankan di folder backend). Bentuknya: base64:xxxxxxxx...
APP_KEY=

# URL yang dibuka di browser
APP_URL=http://localhost:8080

# Kredensial MySQL (dipakai service db dan backend)
DB_DATABASE=summitgear
DB_USERNAME=summitgear
DB_PASSWORD=ganti_dengan_password_kuat

# Akun admin demo untuk login di Postman & halaman Vue
ADMIN_EMAIL=admin@summitgear.test
ADMIN_PASSWORD=ganti_password_admin

# Masa berlaku token login (menit)
SANCTUM_EXPIRATION=1440

# Port di laptop
BACKEND_PORT=8000
FRONTEND_PORT=8080
