# Salin menjadi .env untuk development lokal (npm run dev).
# File .env TIDAK di-commit.

# Alamat dasar API yang dipakai Axios.
# "/api" = lewat proxy (Vite saat dev, Nginx saat di Docker).
VITE_API_URL=/api

# Nama aplikasi yang tampil di header.
VITE_APP_NAME=SummitGear

# Target proxy Vite saat `npm run dev` (backend Laravel lokal / container).
VITE_DEV_PROXY_TARGET=http://localhost:8000
